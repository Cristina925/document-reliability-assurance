<tr><th scope="row" class="table__nowrap align-left">30 June 2024</th><th scope="row" class="table__nowrap align-right">UK</th><td class="align-right">        3,871,000 </td><td class="align-right">         9,244,000 </td><td class="align-right">13,115,000</td></tr>
</table><footer class="figure__footer">
