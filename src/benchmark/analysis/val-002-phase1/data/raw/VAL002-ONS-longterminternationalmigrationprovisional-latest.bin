<tr class="table__header-row table__nowrap"><td class="align-left"></td><th scope="col" class="align-center">Male</th><th scope="col" class="align-center">Female</th><th scope="col" class="align-center">Male</th><th scope="col" class="align-center">Female</th><th scope="col" class="align-center">Male</th><th scope="col" class="align-center">Female</th></tr>
