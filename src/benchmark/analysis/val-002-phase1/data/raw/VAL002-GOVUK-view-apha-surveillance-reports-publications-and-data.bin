  <h1 class="gem-c-heading__text govuk-heading-xl">
    APHA animal surveillance reports, publications and dashboards
</h1></div>
  </div>
</div>

<div class="govuk-grid-row gem-print-columns-none">
  <div class="govuk-grid-column-two-thirds">
        <p class="gem-c-lead-paragraph govuk-!-margin-bottom-8" dir="ltr">
    Access APHA reports, videos, publications and data on livestock, wildlife and small animals in England and Wales.
</p>

  </div>

</div>



