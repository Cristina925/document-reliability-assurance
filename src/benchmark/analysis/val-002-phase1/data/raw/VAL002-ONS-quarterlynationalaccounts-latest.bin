                dataLayer[0]["url"] = "/economy/grossdomesticproductgdp/bulletins/quarterlynationalaccounts/januarytomarch2026";
            
        
    

    
    
        
            dataLayer[0]["wordCount"] = 8344
        
    

    
    

    

</script>


