    <h4 class="print--hide font-size--h6 padding-top--0"><span role="text">Download this table <span class="visuallyhidden">Table 1: Headline national accounts indicators for the UK </span></span></h4>
    <a href="/download/table?format=xlsx&uri=/economy/grossdomesticproductgdp/bulletins/quarterlynationalaccounts/januarytomarch2026/eda16b21.json" title="Download as xls" class="btn btn--primary print--hide" data-gtm-title="Table 1: Headline national accounts indicators for the UK " data-gtm-type="download-table-xlsx" aria-label="Download Table 1: Headline national accounts indicators for the UK  as xls">.xls</a>
