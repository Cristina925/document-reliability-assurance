<tr><th scope="row" class="align-left">Total primary income </th><th scope="row" class="align-left">Value (£bn)</th><td class="align-right">107.1</td><td class="align-right">111.0</td><td class="align-right">-3.9</td></tr>
<tr><td class="align-left"></td><th scope="row" class="align-left">Change (£bn)</th><td class="align-right">6.5</td><td class="align-right">-1.5</td><td class="align-right">8.0</td></tr>
<tr><th scope="row" class="align-left">Total secondary income </th><th scope="row" class="align-left">Value (£bn)</th><td class="align-right">8.0</td><td class="align-right">11.6</td><td class="align-right">-3.5</td></tr>
<tr><td class="align-left"></td><th scope="row" class="align-left">Change (£bn)</th><td class="align-right">0.0</td><td class="align-right">-0.3</td><td class="align-right">0.3</td></tr>
</table><footer class="figure__footer">
