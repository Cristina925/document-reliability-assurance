<tr><th scope="row" class="align-left">Total trade in goods and services </th><th scope="row" class="align-left">Value (£bn)</th><td class="align-right">236.4</td><td class="align-right">244.1</td><td class="align-right">-7.7</td></tr>
<tr><td class="align-left"></td><th scope="row" class="align-left">Change (£bn)</th><td class="align-right">1.9</td><td class="align-right">7.1</td><td class="align-right">-5.1</td></tr>
<tr><th scope="row" class="align-left">Total trade in goods</th><th scope="row" class="align-left">Value (£bn)</th><td class="align-right">96.1</td><td class="align-right">155.6</td><td class="align-right">-59.5</td></tr>
<tr><td class="align-left"></td><th scope="row" class="align-left">Change (£bn)</th><td class="align-right">2.2</td><td class="align-right">6.2</td><td class="align-right">-4.0</td></tr>
