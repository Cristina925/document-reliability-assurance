	<div class=" margin-bottom-sm--2 margin-bottom-md--2 print--hide">
		<a class="btn btn--primary btn--full-width" href="/peoplepopulationandcommunity/populationandmigration/populationestimates/bulletins/annualmidyearpopulationestimates/mid2024/relateddata" data-gtm-title="" data-gtm-type="related-data">
			
			

			
			
